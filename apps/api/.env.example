# Local development only. Copy to .env (git-ignored) and replace the placeholders
# with the password you chose for the local mansar_dev PostgreSQL role.
# Deployed environments (staging, later production) never use this file: every
# value below is set in the hosting platform's secret/config store, and the API
# reads .env only when the file exists. See docs/staging-deployment.md.
#
# Secret. Local: the mansar_dev role. Staging: injected by the platform.
DATABASE_URL=postgresql://mansar_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mansar_dev
# Local/test only. Real-database integration tests (npm run test:db) require
# this and refuse any database other than mansar_test. Not used in staging.
TEST_DATABASE_URL=postgresql://mansar_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mansar_test
# Non-secret. Listening port; hosting platforms usually inject their own PORT.
PORT=3001
# Secret. HS256 signing secret for access tokens: canonical base64url of at
# least 32 random bytes. Generate your own private value, never commit it:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Staging uses a different, separately generated value.
JWT_ACCESS_SECRET=REPLACE_WITH_BASE64URL_RANDOM_48_BYTES
# Non-secret. Express "trust proxy" hops for req.ip (0-10). 0 = none: local
# dev, and also the Railway staging value (deliberate; see
# docs/staging-deployment.md section 7).
TRUST_PROXY_HOPS=0
# Non-secret. Client identity for login/refresh rate limiting: "socket"
# (req.ip; unset means the same) or "railway-x-real-ip" (Railway's X-Real-IP
# header; appropriate for the verified Railway staging topology described in
# docs/staging-deployment.md section 7, not for other ingress paths).
# Any other value, including a header name, refuses to start.
RATE_LIMIT_CLIENT_IP_SOURCE=socket
