{
  "name": "@mansar/api",
  "version": "0.0.0",
  "private": true,
  "description": "Mansar Trucking Management System v2 backend API (NestJS).",
  "type": "module",
  "engines": {
    "node": "^24.20.0"
  },
  "scripts": {
    "build:deps": "tsc -b ../../packages/types && npm run db:generate",
    "db:generate": "prisma generate --config ./prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config ./prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config ./prisma7.config.ts",
    "db:migrate:status": "prisma migrate status --config ./prisma7.config.ts",
    "db:diff:check": "prisma migrate diff --config ./prisma7.config.ts --from-config-datasource --to-schema=prisma/schema.prisma --exit-code",
    "db:reset": "prisma migrate reset --config ./prisma7.config.ts",
    "db:studio": "prisma studio --config ./prisma7.config.ts",
    "db:test:migrate": "node scripts/test-db-migrate.mjs deploy",
    "db:test:status": "node scripts/test-db-migrate.mjs status",
    "preadmin:create": "npm run build",
    "admin:create": "node dist/cli/create-admin.js",
    "predriver:create": "npm run build",
    "driver:create": "node dist/cli/create-driver.js",
    "prebuild": "npm run build:deps",
    "build": "nest build",
    "prestart": "npm run build:deps",
    "start": "nest start",
    "prestart:dev": "npm run build:deps",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "pretest:watch": "npm run build:deps",
    "test:watch": "vitest",
    "pretest:db": "npm run build:deps",
    "test:db": "vitest run --config vitest.config.db.ts"
  },
  "dependencies": {
    "@mansar/types": "*",
    "@nestjs/common": "~12.0.3",
    "@nestjs/core": "~12.0.3",
    "@nestjs/platform-express": "~12.0.3",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mansar/config": "*",
    "@nestjs/cli": "~12.0.3",
    "@nestjs/schematics": "~12.0.3",
    "@nestjs/testing": "~12.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "typescript": "~6.0.3"
  }
}
