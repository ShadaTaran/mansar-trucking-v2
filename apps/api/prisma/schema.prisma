// Prisma ORM 7 schema. The connection URL lives in prisma7.config.ts, never here.
// Domain models arrive with their feature stages.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Authorization role of a login identity.
enum UserRole {
  ADMIN
  DRIVER

  @@map("user_role")
}

/// Authentication identity. Operational driver data lives in the `drivers`
/// table (ADR 0002); no profile or business fields belong here.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Canonical (normalized) login email; normalization is application logic.
  email        String   @unique @db.Text
  /// Encoded password hash (salt and parameters embedded). Never plaintext.
  passwordHash String   @map("password_hash") @db.Text
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs       AuditLog[]       @relation("AuditLogActor")
  refreshSessions RefreshSession[]
  /// The operational driver this login belongs to, if any (at most one).
  driver          Driver?

  @@map("users")
}

/// Operational availability of a driver record; independent of the login's
/// `is_active`.
enum DriverStatus {
  ACTIVE
  INACTIVE

  @@map("driver_status")
}

/// Frozen Stage 4 vehicle lifecycle.
enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  RETIRED

  @@map("vehicle_status")
}

/// Operational driver (ADR 0002): may exist without a login; at most one login
/// per driver and one driver per login. Rows are never hard-deleted; the
/// lifecycle is `status`. A linked login cannot be deleted while linked.
model Driver {
  id            String       @id @default(uuid(7)) @db.Uuid
  userId        String?      @unique(map: "drivers_user_id_key") @map("user_id") @db.Uuid
  fullName      String       @map("full_name") @db.Text
  phone         String       @db.Text
  licenceNumber String       @map("licence_number") @db.Text
  /// Calendar date (no time, no zone).
  licenceExpiry DateTime?    @map("licence_expiry") @db.Date
  status        DriverStatus @default(ACTIVE)
  notes         String       @default("") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  trips Trip[]

  @@map("drivers")
}

/// Fleet vehicle. `plate_number` is stored already normalized by the API
/// (trim, collapse internal whitespace, upper-case) and is unique as stored.
model Vehicle {
  id              String        @id @default(uuid(7)) @db.Uuid
  plateNumber     String        @unique(map: "vehicles_plate_number_key") @map("plate_number") @db.Text
  make            String        @db.Text
  model           String        @db.Text
  year            Int
  status          VehicleStatus @default(ACTIVE)
  currentOdometer Int?          @map("current_odometer")
  notes           String        @default("") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  trips Trip[]

  @@map("vehicles")
}

/// Frozen trip lifecycle (Stage 0, ADR 0003). Mirrors the shared tuple
/// `TRIP_STATUSES` in @mansar/types; the API asserts the two stay identical.
enum TripStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
  CANCELLED

  @@map("trip_status")
}

/// A haulage job. Rows are never hard-deleted; `status` is the lifecycle.
/// Ownership is the operational `Driver` (ADR 0002) — a trip never snapshots a
/// login identity.
///
/// The scheduled window is half-open `[scheduledStartAt, scheduledEndAt)`, so
/// back-to-back trips do not overlap. Six PostgreSQL-native invariants are
/// added by hand in the migration and are invisible to `db:diff:check`
/// (docs/database.md §15), so `test/trips-persistence.int-spec.ts` proves each
/// one against a real database:
///   - `trips_schedule_order`              end is after start when both exist
///   - `trips_assignment_complete`         past DRAFT/CANCELLED the driver,
///                                         vehicle and window are all present
///   - `trips_driver_schedule_excl`        no overlapping windows per driver
///   - `trips_vehicle_schedule_excl`       no overlapping windows per vehicle
///   - `trips_one_in_progress_per_driver`  at most one running trip per driver
///   - `trips_one_in_progress_per_vehicle` at most one running trip per vehicle
model Trip {
  id               String     @id @default(uuid(7)) @db.Uuid
  status           TripStatus @default(DRAFT)
  driverId         String?    @map("driver_id") @db.Uuid
  vehicleId        String?    @map("vehicle_id") @db.Uuid
  origin           String     @db.Text
  destination      String     @db.Text
  /// Planned window; nullable only while the trip is DRAFT or CANCELLED.
  scheduledStartAt DateTime?  @map("scheduled_start_at") @db.Timestamptz(3)
  scheduledEndAt   DateTime?  @map("scheduled_end_at") @db.Timestamptz(3)
  /// Actual instants, written by the trip state machine in a later substage.
  startedAt        DateTime?  @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?  @map("completed_at") @db.Timestamptz(3)
  notes            String     @default("") @db.Text
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  expenses Expense[]

  @@index([status, scheduledStartAt, id], map: "trips_status_scheduled_start_at_id_idx")
  @@index([driverId, scheduledStartAt, id], map: "trips_driver_id_scheduled_start_at_id_idx")
  @@index([vehicleId, scheduledStartAt, id], map: "trips_vehicle_id_scheduled_start_at_id_idx")
  @@map("trips")
}

/// Frozen Stage 6 expense lifecycle. Mirrors the shared tuple
/// `EXPENSE_STATUSES` in @mansar/types; the API asserts the two stay
/// identical. APPROVED and REJECTED are terminal: there is no reopen and no
/// return to SUBMITTED, so a correction is a new expense and the incorrect
/// row survives as history.
enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED

  @@map("expense_status")
}

/// Frozen Stage 6 expense categories. A closed set keeps review and
/// reporting on a fixed vocabulary; `OTHER` absorbs the long tail rather
/// than inviting free-text categories.
enum ExpenseCategory {
  FUEL
  TOLL
  PARKING
  MEAL
  REPAIR
  OTHER

  @@map("expense_category")
}

/// A cost incurred against one trip. Rows are never hard-deleted; `status`
/// is the lifecycle.
///
/// Ownership is deliberately *not* stored. An expense cannot be submitted
/// before its trip is IN_PROGRESS, and a trip can no longer be re-assigned
/// by then, so the operational driver is always `trip.driverId` and a second
/// copy would only be an invariant to keep in step. The acting identity —
/// including an ADMIN filing on a driver's behalf — is the audit row's
/// actor, not a column here (ADR 0002).
///
/// `amount` is PHP only; there is no currency column (docs/database.md §14).
/// It crosses the API as a decimal *string* so no consumer can round it
/// through an IEEE-754 double.
///
/// Three CHECK constraints are added by hand in the migration and are
/// invisible to `db:diff:check` (docs/database.md §15), so
/// `test/expenses-persistence.int-spec.ts` proves each against a real
/// database:
///   - `expenses_amount_positive`          a zero or negative cost is not one
///   - `expenses_review_consistency`       reviewed exactly when not SUBMITTED
///   - `expenses_rejection_requires_note`  a rejection always says why
model Expense {
  id          String          @id @default(uuid(7)) @db.Uuid
  tripId      String          @map("trip_id") @db.Uuid
  status      ExpenseStatus   @default(SUBMITTED)
  /// PHP, two decimal places. Never serialized as a JavaScript number.
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  /// When the money was spent, which is not when the row was filed.
  incurredAt  DateTime        @map("incurred_at") @db.Timestamptz(3)
  description String          @default("") @db.Text
  /// Why a review decided what it did. Required on REJECTED.
  reviewNote  String          @default("") @map("review_note") @db.Text
  /// Server-set at APPROVE/REJECT; null while SUBMITTED.
  reviewedAt  DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// At most one receipt image, ever (Stage 6D).
  receipt Receipt?

  @@index([status, incurredAt, id], map: "expenses_status_incurred_at_id_idx")
  @@index([tripId, incurredAt, id], map: "expenses_trip_id_incurred_at_id_idx")
  @@map("expenses")
}

/// The receipt image backing one expense (Stage 6D, ADR 0009). Metadata
/// only: the binary lives in object storage and never enters PostgreSQL or
/// passes through the API.
///
/// **At most one receipt row per expense, ever.** `expense_id` is unique, so
/// a retry reuses the same row and the same key rather than accumulating
/// abandoned objects — Stage 6 has no cleanup mechanism, and a model that
/// stranded a row per attempt would need one. A pending row's declaration
/// may still be corrected; once `confirmed_at` is set the row is immutable
/// and no further upload is ever authorized for it.
///
/// `object_key` is server-generated (`receipts/{expenseId}/{receiptId}`),
/// never accepted from a client and never returned on the wire. It is unique
/// as a storage-integrity invariant: one object locator must never be
/// claimed by two rows.
///
/// There is no `status`: `confirmed_at` is the entire lifecycle, and a second
/// representation of it would only be an invariant to keep in step. There is
/// no `updated_at`, because a confirmed row never changes again. The
/// uploading identity is the audit row's actor, not a column here (ADR 0002).
///
/// Two CHECK constraints are added by hand in the migration and are
/// invisible to `db:diff:check` (docs/database.md §15), so
/// `test/receipts-persistence.int-spec.ts` proves each against a real
/// database:
///   - `receipts_byte_size_range`        1 byte .. 10 MiB, integers only
///   - `receipts_content_type_allowed`   exactly JPEG, PNG or WebP
model Receipt {
  id          String    @id @default(uuid(7)) @db.Uuid
  expenseId   String    @unique(map: "receipts_expense_id_key") @map("expense_id") @db.Uuid
  /// Server-generated storage locator. Never on the wire, never audited.
  objectKey   String    @unique(map: "receipts_object_key_key") @map("object_key") @db.Text
  contentType String    @map("content_type") @db.Text
  byteSize    Int       @map("byte_size")
  /// Set once the object was verified in storage; null while pending.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("receipts")
}

/// Append-only record of significant actions. Survives actor deletion.
model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  /// Role snapshot at the time of the action; kept even if the actor is removed.
  actorRole   UserRole? @map("actor_role")
  action      String    @db.Text
  entityType  String    @map("entity_type") @db.Text
  entityId    String?   @map("entity_id") @db.Text
  requestId   String?   @map("request_id") @db.Text
  metadata    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_user_id_created_at_idx")
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_logs_entity_type_entity_id_created_at_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

/// Which first-party client a refresh session was issued to.
enum RefreshClient {
  WEB
  MOBILE

  @@map("refresh_client")
}

/// Why a refresh session stopped being usable.
enum RefreshRevocationReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  DEACTIVATED
  PASSWORD_RESET
  REUSE_DETECTED

  @@map("refresh_revocation_reason")
}

/// One refresh-token session. The plaintext token is never stored; only the
/// SHA-256 of its 256-bit random value. Rotation revokes the row (ROTATED)
/// and creates a replacement in the same family; presenting a rotated token
/// again is treated as reuse and revokes the whole family.
model RefreshSession {
  id              String                   @id @default(uuid(7)) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  /// Rotation-family identifier: generated at login, copied on rotation.
  familyId        String                   @default(uuid(7)) @map("family_id") @db.Uuid
  tokenHash       String                   @unique(map: "refresh_sessions_token_hash_key") @map("token_hash") @db.Text
  client          RefreshClient
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz(3)
  /// Absolute cap for the whole family; never extended by rotation.
  familyExpiresAt DateTime                 @map("family_expires_at") @db.Timestamptz(3)
  lastUsedAt      DateTime?                @map("last_used_at") @db.Timestamptz(3)
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason   RefreshRevocationReason? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "refresh_sessions_user_id_idx")
  @@index([familyId], map: "refresh_sessions_family_id_idx")
  @@map("refresh_sessions")
}
