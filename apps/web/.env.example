# Server-only (no NEXT_PUBLIC_ prefix): the browser never calls the API
# directly. Neither value is a secret.
# Origin of the Nest API as reachable from the Next.js server.
API_INTERNAL_URL=http://127.0.0.1:3001
# Exact origin browsers must present on unsafe /api requests (CSRF check).
WEB_ORIGIN=http://localhost:3000
