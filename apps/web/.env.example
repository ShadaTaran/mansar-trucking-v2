# Server-only (no NEXT_PUBLIC_ prefix): the browser never calls the API
# directly. Neither value is a secret. Deployed environments set both in the
# hosting platform's config store (this file is local development only); see
# docs/staging-deployment.md.
#
# Origin of the Nest API as reachable from the Next.js server: scheme + host
# (+ port), no path. Staging form: https://<staging-api-host>
API_INTERNAL_URL=http://127.0.0.1:3001
# Exact origin browsers must present on unsafe /api requests (CSRF check):
# the public origin of this web app. Staging form: https://<staging-web-host>
WEB_ORIGIN=http://localhost:3000
