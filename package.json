{
  "name": "mansar-trucking-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Mansar Trucking Management System v2 monorepo",
  "engines": {
    "node": "^24.3.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "tsc -b && npm run test --workspaces --if-present",
    "build": "tsc -b && npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
