{
  "name": "@mansar/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Mansar Trucking Management System v2 driver mobile application (React Native, Android).",
  "scripts": {
    "build:deps": "tsc -b ../../packages/types",
    "prestart": "npm run build:deps",
    "start": "react-native start",
    "preandroid": "npm run build:deps",
    "android": "react-native run-android",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "npm run build:deps",
    "test": "jest",
    "pretest:watch": "npm run build:deps",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@mansar/types": "*",
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@mansar/config": "*",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.0",
    "jest": "29.7.0",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^24.3.0"
  }
}
